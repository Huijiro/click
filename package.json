{
  "name": "click",
  "description": "SQLite-based persistent memory for AI agents (Pi extension + MCP) with FTS5 search, project/user scoping, and auto-injection.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mcp",
    "memory",
    "sqlite"
  ],
  "bin": {
    "click-mcp": "./bin/click-mcp.mjs"
  },
  "scripts": {
    "build": "node scripts/build-cursor.mjs",
    "check": "biome check && tsc --noEmit && npm test",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "tsx --test src/**/*.test.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "inject:smoke": "tsx scripts/inject-smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  }
}
